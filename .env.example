# Copy to .env.local and fill in. Never commit .env.local.

# Clerk: dashboard > Configure > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# MongoDB Atlas connection string (Atlas is a replica set, which stock move transactions need)
MONGODB_URI=
# your own dev data: stocksense_<yourname>. The deployed demo uses stocksense
MONGODB_DB=

# Playwright e2e: a Clerk user made for tests only
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
